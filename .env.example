# Permanent System User token from Meta Business Settings (secret)
WA_ACCESS_TOKEN=EAAG...replace-me
# Meta App -> Settings -> Basic -> App secret (secret)
WA_APP_SECRET=replace-me
# Any random string you choose; enter the same value in the Meta webhook config (secret)
WA_VERIFY_TOKEN=replace-with-a-long-random-string
# WhatsApp -> API Setup -> Phone number ID
WA_PHONE_NUMBER_ID=123456789012345
GRAPH_API_VERSION=v25.0
LOG_LEVEL=INFO
# Optional: comma-separated numbers the bot may reply to (e.g. 919876543210). Empty = everyone.
ALLOWED_SENDERS=

# Neon - same database as mybill-service; tables live in schema "agent".
# Pooled endpoint (host has "-pooler") for the app:
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require
# Direct endpoint (no "-pooler") for Alembic migrations only:
DATABASE_URL_DIRECT=postgresql://neondb_owner:PASSWORD@ep-xxxx.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_SCHEMA=agent

# Queue. false = process in a FastAPI BackgroundTask (local dev).
USE_CLOUD_TASKS=false
GCP_PROJECT=project-0708fb26-e204-4400-ae9
TASKS_QUEUE=srisa-agent-messages
TASKS_LOCATION=asia-south1
TASKS_TARGET_URL=https://srisa-agent-276371417285.asia-south1.run.app
TASKS_SERVICE_ACCOUNT=srisa-agent-tasks@project-0708fb26-e204-4400-ae9.iam.gserviceaccount.com

# ── AI agent (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=600
LLM_MAX_TOOL_ITERATIONS=5
LLM_TIMEOUT_SECONDS=30
LLM_EFFORT=low
HISTORY_MESSAGES=20
BRAND_NAME=SRISA Boutique

# ── mybill-service agent API (read-only catalog for the tools) ──
MYBILL_BASE_URL=https://mybill-service-276371417285.us-central1.run.app
MYBILL_AUDIENCE=https://mybill-service-276371417285.us-central1.run.app
# google = ID token (metadata server on Cloud Run, or MYBILL_ID_TOKEN below); none = local mybill with "local" profile
MYBILL_AUTH=google
# MYBILL_ID_TOKEN=   # local only: gcloud auth print-identity-token --impersonate-service-account=srisa-agent-sa@... --audiences=$MYBILL_AUDIENCE --include-email

# ── Admin endpoints (POST /admin/conversations/{id}/resume) ─────
ADMIN_API_KEY=replace-with-a-long-random-string
ADMIN_ALLOWED_EMAILS=srisafabricshyd@gmail.com
